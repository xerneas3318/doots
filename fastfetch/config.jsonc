{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/images/fetch.png",
    "type": "kitty",
    "width": 50,
    "height": 28,
    "padding": {
      "top": 0,
      "right": 4
    }
  },
  "display": {
    "showErrors": true,
    "color": {
      "title": "#d4a890",
      "keys": "#a5cad3",
      "separator": "#7da8b2",
      "output": "default"
    }
  },
  "modules": [
    "break",
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "battery",
    "break",
    "colors",
    "break",
    "break"
  ]
}
