{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/images/fetch.png",
    "type": "kitty",
    "width": 50,
    "height": 25,
    "padding": {
      "top": 0,
      "right": 4
    }
  },
  "display": {
    "showErrors": true
  },
  "modules": [
    "break",
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "battery",
    "break",
    "colors"
  ]
}
